<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is already targeting the public directory, leave it alone.
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # If the request points to an existing file or directory in the project root,
    # serve it directly and do not rewrite it.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, route the request into the public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>