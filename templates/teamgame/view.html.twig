{# templates/game/view.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0.1em;
            height: 1.5em;
            width: 50%;
        }
    </style>
    
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>Start Time:</td>
                <td>{{ teamgame.startingtime|date("g:ia") }}</td>
            </tr>
            <tr>
                <td>{{ teamgame.teamone }}:</td>
                <td>
                    {% set playerCounter = 0 %}
                    {% for teamplayer in teamgame.players %}
                        {% if teamplayer.teamnumber == 1 %}
                            {% set playerCounter = playerCounter + 1 %}
                        {% endif %}
                    {% endfor %}
                    
                    {% for teamplayer in teamgame.players %}
                        {% if teamplayer.teamnumber == 1 %}
                            {{ teamplayer.player.name.fullname }}

                            {% set playerCounter = playerCounter - 1 %}
                            {% if playerCounter > 0 %} 
                                ,
                            {% endif %}
                        {% endif %}
                    {% endfor %}
        
                </td>
            </tr>
            {% if event.playersperteam < 4 %}
                <tr>
                    <td>{{ teamgame.teamtwo }}:</td>
                    <td>
                        {% set playerCounter = 0 %}
                        {% for teamplayer in teamgame.players %}
                            {% if teamplayer.teamnumber == 2 %}
                                {% set playerCounter = playerCounter + 1 %}
                            {% endif %}
                        {% endfor %}
                        
                        {% for teamplayer in teamgame.players %}
                            {% if teamplayer.teamnumber == 2 %}
                                {{ teamplayer.player.name.fullname }}

                                {% set playerCounter = playerCounter - 1 %}
                                {% if playerCounter > 0 %} 
                                    ,
                                {% endif %}
                            {% endif %}
                        {% endfor %}
            
                    </td>
                </tr>
            {% endif %}
        </tbody>
    </table>
{% endblock %}