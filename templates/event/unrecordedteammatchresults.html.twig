{# templates/event/unrecordedteammatchresults.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    {% set sessionName = event.session.name %}
    <h3>{{ league.name }} {{ season.name }} Season</h3>
    <h4>Unable to compute the results for {{ sessionName }} Event# {{ event.eventnumber }} as the following teams have not yet recorded their scores: </h4>
    
    <ul>
    {% for game in games %}
    	<li>
    		{% set teammatch = game.teammatches[0] %}
            {% set teamone = teammatch.teamone %}
            {% set teamtwo = teammatch.teamtwo %}
			{{ teamone.name }} vs {{ teamtwo.name }}
    	</li>
    {% endfor %}
    </ul>
{% endblock %}