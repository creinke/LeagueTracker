{# templates/event/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .form-control {
            padding: 0.3em inherit;
            height: 1.5em;
            width: 100%;
        }
        label {
            margin-bottom: 0.15em;
        }
    </style>

    <div>
        <h3 style="margin-bottom: 0px;">Event #{{ event.eventnumber }} on {{ event.startdateandtime|date("m/d/Y") }} @ {{ event.startdateandtime|date("g:ia")  }}</h3>
        <h4 style="margin-left: 5em;">{{ event.description }}</h4>
    
        {{ form_start(form) }}
        {{ form_widget(form) }}
        {{ form_end(form) }}
    </div>
    
    <script type="text/javascript">
        function showOrHideTeamMatchHtml() {
            if ($eventTypeValue == '4' && $eventFormatValue != '5') {
                $withhandicappingCheckboxDiv.show();
            } else {
                $withhandicappingCheckboxDiv.hide();
            }
        }

        function removeOutOfContextItemsFromDropdowns() {
            if ($eventTypeValue == '4') {
                jQuery('#form_event_eventtype option[value="1"]').remove();
                jQuery('#form_event_eventtype option[value="2"]').remove();
                jQuery('#form_event_eventtype option[value="3"]').remove();
                jQuery('#form_event_eventtype option[value="5"]').remove();
            } else if ($eventTypeValue == '5') {
                jQuery('#form_event_eventtype option[value="1"]').remove();
                jQuery('#form_event_eventtype option[value="2"]').remove();
                jQuery('#form_event_eventtype option[value="3"]').remove();
                jQuery('#form_event_eventtype option[value="4"]').remove();
            } else {
                jQuery('#form_event_eventtype option[value="4"]').remove();
                jQuery('#form_event_eventtype option[value="5"]').remove();
            }
        }
    </script>
    
    <script type="text/javascript">
        var $eventTypeSelect;
        var $withhandicappingCheckbox;
        var $withhandicappingCheckboxDiv;
        var $eventFormatValue;
        var $eventTypeValue;
    
        jQuery(document).ready(function() {
            $eventTypeSelect = jQuery('#form_event_eventtype');
            $withhandicappingCheckbox = jQuery('#form_event_withhandicapping');
            $withhandicappingCheckboxDiv = $withhandicappingCheckbox.parent();
            $eventTypeValue = $eventTypeSelect.val();
    
            showOrHideTeamMatchHtml();
            removeOutOfContextItemsFromDropdowns();
            
            $eventFormatSelect.on('change', function() {
                $eventFormatValue = this.value;
                showOrHideTeamMatchHtml();
            });
        });
    </script>
    
    <script type="text/javascript">
        var $course = jQuery('#form_event_course');
         
        // When course gets selected ...
        $course.change(function() {
            // ... Retrieve the corresponding form.
            var $form = jQuery(this).closest('form');
            // Simulate form data, but only include the selected course value.
            var data = {};
            data[$course.attr('name')] = $course.val();
            //$token = jQuery('#form__token');
            //data[$token.attr('name')] = $token.val();
            
            // Submit data via AJAX to the form's action path.
            jQuery.ajax({
                url : $form.attr('action'),
                type: $form.attr('method'),
                data : data,
                success: function(html) {
                    // Replace nines dropdown with the one returned from the AJAX response.
                    jQuery('#form_event_nine').replaceWith(jQuery(html).find('#form_event_nine'));
                    jQuery('#form_event_secondnine').replaceWith(jQuery(html).find('#form_event_secondnine'));
                    
                    // Replace tees dropdown with the one returned from the AJAX response.
                    jQuery('#form_event_tee').replaceWith(jQuery(html).find('#form_event_tee'));
                }
            });
        });
    </script>
    
    <div>
        <h3>Games</h3>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="text-right">
                {% if event.isTeamEvent(eventType) %}
                    <a href="{{ path('teamgame_new', {'event_id': event.id})  }}" class="btn btn-dark">Add New Team Event Game</a>
                {% else %}
                    <a href="{{ path('game_new', {'event_id': event.id})  }}" class="btn btn-dark">Add New Game</a>
                    
                    {% if event.games is empty %}
                        <a href="{{ path('game_generate', {'event_id': event.id})  }}" class="btn btn-dark">Generate Games</a>
                    {% endif %}
                {% endif %}  
            </div>
        {% endif %}
        
        {% if event.isTeamEvent(eventType) %}
            {% if event.teamgames is not empty  %}
                {% set teamgames = event.sortedTeamgames %}
                <table class="table">
                    <tbody>
                        {% for teamgame in teamgames %}
                            {% set teamone = teamgame.teamone %}
                            {% set teamtwo = teamgame.teamtwo %}
        
                            <tr>
                                <td>Game #{{ loop.index }} @ {{ teamgame.startingtime|date("g:ia")  }}</td>
                                <td>
                                    {{ teamone }}
                                    {% if teamtwo is not empty %}
                                        - playing with - {{ teamtwo }}
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('teamgame_view', {'event_id': event.id, 'teamgame_id': teamgame.id, 'gamenumber': loop.index}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                    {% if is_granted('ROLE_SAMPLE') %}
                                    {% elseif is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('teamgame_delete', {'event_id': event.id, 'teamgame_id': teamgame.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                    {% endif %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('teamgame_edit', {'event_id': event.id, 'teamgame_id': teamgame.id, 'gamenumber': loop.index}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% elseif event.games is not empty %}
            {% set games = event.games %}
            
            <table class="table">
                <tbody>
                    {% for game in event.sortedGames %}
                        <tr>
                            <td>Game #{{ loop.index }} @ {{ game.startingtime|date("g:ia")  }}</td>
                            
                            {% if singlesMatch %}
                                <td>
                                    {% if game.playermatches.count == 0 %} 
                                        {% for player in game.players %}
                                            {% if loop.index0 != 0 %}
                                                , 
                                            {% endif %}
                                            {{ player.name.lastname }}
                                        {% endfor %}
                                    {% else %}
                                        {% for playermatch in game.playermatches %}
                                            {% if loop.index0 != 0 %}
                                                , 
                                            {% endif %}
                                            {{ playermatch.playerone.name.lastname }} vs
                                            {{ playermatch.playertwo.name.lastname }}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                            {% else %}
                                {% set teammatch = game.teammatches[0] %}
                                {% set teamone = teammatch.teamone %}
                                {% set teamtwo = teammatch.teamtwo %}
            
                                <td>{{ teamone.name }} vs {{ teamtwo.name }}</td>
                            {% endif %}
                            <td>
                                <a href="{{ path('game_view', {'event_id': event.id, 'game_id': game.id, 'gamenumber': loop.index}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                {% if is_granted('ROLE_SAMPLE') %}
                                {% elseif is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('game_delete', {'event_id': event.id, 'game_id': game.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('game_edit', {'event_id': event.id, 'game_id': game.id, 'gamenumber': loop.index}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                {% endif %}
                            </td>
                        </tr>
    
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
    <!-- <a href="{{ path('event_list', {'id': season.id}) }}" style="margin-top: 100px;" class="btn btn-dark">Event List</a>  -->
{% endblock %}