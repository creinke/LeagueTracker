{# templates/event/teameventresults.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .hr-reverted {
        	width: 100% !important;
        	height: unset !important; 
        	border-bottom: 1px solid #555 !important;
        	background-image: unset !important; 
        	background-size: unset !important; 
        	background-position: center !important; 
        	background-repeat: unset !important; 
        	margin: unset !important; 
        	position: unset !important; 
        	border: unset !important; 
        	content: unset !important;
        	z-index: unset !important; 
        }
		.table, .table-responsive {
			background-image: unset;
			margin-bottom: 30px;
		}
        th {
            text-align: center;
            white-space: nowrap;
        }
        .table td, .table > tbody > tr > td, .table th, .table > tbody > tr > th, .table tr td:first-child {
            border-top: 1px;
            box-shadow: unset; 
            padding: 0px !important;
            color: #555;
            text-align: center;
        }
    </style>
    
    {% set sessionName = event.session.name %}

    <h3>
        {{ league.name }}: {{ season.name }} Season 
            <input type="button" value="Print Results" id="print_button" class="btn btn-primary mt-3" style="float:right;"/>
    </h3>
    
    <h4>Results for {{ sessionName }} Event# {{ event.eventnumber }}</h4>
    <h4 style="margin-left: 5em;">{{ singlesMatchPlayEventViewBean.description }}</h4>
    <br/><br/>
    
    <div class="table-responsive"> 
        <table class="table table-condensed">
            <tr>
                <th>Player Name</th>
                <th>Place</th>
                {% if singlesMatchPlayEventViewBean.displayNet %}
                    <th>Net Score</th>
                {% endif %}
                {% if singlesMatchPlayEventViewBean.displayTotal %}
                    <th>Total Score</th>
                {% endif %}
                <th>Tie Breaker</th>
                <th>Skins</th>
            </tr>
            <tr>
                <td colspan="6"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
            {# $standings #}
            {% for player in singlesMatchPlayEventViewBean.players %}
                <tr>
                    <td style="text-align: left;">{{ player['name'] }}</td>
                    <td>{{ player['place'] }}</td>
                    {% if singlesMatchPlayEventViewBean.displayNet %}
                        <td>{{ player['totalNetScore'] }}</td>
                    {% endif %}
                    {% if singlesMatchPlayEventViewBean.displayTotal %}
                        <td>{{ player['totalScore'] }}</td>
                    {% endif %}
                    <td>
                        {% if player['tieBreaker'] is not empty %}
                            {{ player['tieBreaker'] }}
                        {% else %}
                            &nbsp;
                        {% endif %}
                    </td>
                    <td>
                        {% if player['skins'] is not empty %}
                            {{ player['skins'] }}
                        {% else %}
                            &nbsp;
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="6"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
        </table>
    </div>
    
    <div class="table-responsive"> 
        {% set ninesPlayed = singlesMatchPlayEventViewBean.ninesPlayed %}
        {% set firstNine = event.nine.name %}
        {% set secondNine = ninesPlayed == 1 ? null : event.secondnine.name %}
        
        <!-- Player Results Table -->
        <table class="table table-condensed">
            <tr>
                <th colspan="2">&nbsp;</th>
                <th colspan="9">Actual Score/Adjusted Scores/Points</th>
                <th colspan="3">&nbsp;</th>
            </tr>
    
            <tr>
                <th>Name</th>
                {% if  ninesPlayed > 1 %}
                    <th>Nine</th>
                {% endif %}
                <th>HC</th>
                <th>1</th>
                <th>2</th>
                <th>3</th>
                <th>4</th>
                <th>5</th>
                <th>6</th>
                <th>7</th>
                <th>8</th>
                <th>9</th>
                <th>Total</th>
                <th>Net</th>
                <th>Points</th>
            </tr>
            <tr>
                <td colspan="15"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>

            {# $playerResults #}
            {% for games in singlesMatchPlayEventViewBean.gamePlayerMatchResults %}
                {% for playerMatch in games %}
                    {% for playerResults in playerMatch %}
                        {% set totalScore = 0 %}
                        {% set totalNetScore = 0 %}
                        {% set eighteenHoleHandicap = 0 %}
                        
                        {% for playerResult in playerResults %}
                            {% set totalScore = totalScore + playerResult.holeStrokesTotal %}
                            {% set totalNetScore = totalNetScore + playerResult.netStrokesTotal %}
                            {% set eighteenHoleHandicap = eighteenHoleHandicap + playerResult.handicap %}
                            
                            <tr>
                                {% if playerResult.nine.name == firstNine %}
                                    <td style="text-align: left;">{{ playerResult.playerName }}</td>
                                {% else %}
                                    <td>&nbsp;</td>
                                {% endif %}
                                {% if  ninesPlayed > 1 %}
                                    <td>{{ playerResult.nine.name }}</td>
                                {% else %}
                                {% endif %}
                                <td>
                                    {{ playerResult.handicap }}
                                    
                                    {% if  ninesPlayed > 1 %}
                                        {% if playerResult.nine.name == secondNine %}
                                            /{{ eighteenHoleHandicap }}
                                        {% endif %}
                                    {% endif %}
                                </td>
            
                                {% for holeNumber in 0..8 %}
                                    {% set holeStrokes = playerResult.holeStrokes[holeNumber] %}
                                    
                                    <td>
                                        {% if holeStrokes == 0 %}
                                            {{ holeStrokes }}
                                        {% elseif holeStrokes != playerResult.adjustedNetStrokes[holeNumber] %}
                                            {{ holeStrokes }}/{{ playerResult.adjustedNetStrokes[holeNumber] }}
                                        {% else %}
                                            {{ holeStrokes }}
                                        {% endif %}
                                    </td>
                                {% endfor %}
                                {% if  ninesPlayed > 1 %}
                                    {% if playerResult.nine.name == secondNine %}
                                        <td>{{ playerResult.holeStrokesTotal }}/{{ totalScore }}</td>
                                        <td>{{ playerResult.netStrokesTotal }}/{{ totalNetScore }} </td>
                                    {% else %}
                                        <td>{{ playerResult.holeStrokesTotal }}</td>
                                        <td>{{ playerResult.netStrokesTotal }}</td>
                                    {% endif %}
                                {% else %}
                                    <td>{{ playerResult.holeStrokesTotal }}</td>
                                    <td>{{ playerResult.netStrokesTotal }}</td>
                                {% endif %}
                                <td>&nbsp;</td>
                            </tr>
                            <tr>
                                <td>&nbsp;</td>
                                {% if  ninesPlayed > 1 %}
                                    <td>&nbsp;</td>
                                {% endif %}
                                <td>&nbsp;</td>
            
                                {% for holeNumber in 0..8 %}
                                    <td>
                                        {{ playerResult.holePoints[holeNumber] }}
                                    </td>
                                {% endfor %}
                                <td>
                                    {{ playerResult.totalHolePoints }}
                                </td>
                                {% if  ninesPlayed > 1 %}
                                    {% if playerResult.nine.name == firstNine %}
                                        <td>-</td>
                                    {% else %}
                                        <td> {{ playerResult.netPoints }} </td>
                                    {% endif %}
                                {% else %}
                                    <td> {{ playerResult.netPoints }} </td>
                                {% endif %}
                                <td>
                                    {{ playerResult.totalPoints }}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                    <tr>
                        <td colspan="15"><hr style="border-bottom: 1px solid #555 !important;" class="hr-reverted"/></td>
                    </tr>
                {% endfor %}
                <tr>
                    <td colspan="15"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
                </tr>
            {% endfor %}
        </table>
    </div>
    
    <h4>Season standings after {{ sessionName }} Event# {{ event.eventnumber }}</h4>
    
    <div class="table-responsive"> 
        <table class="table table-condensed">
            <tr>
                <th>Player Name</th>
                <th>Session Points</th>
                <th>Total Points</th>
            </tr>
            <tr>
                <td colspan="3"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
            {# $standings #}
            {% for player in players %}
                <tr>
                    <td style="text-align: left;">{{ player['name'] }}</td>
                    <td>{{ singlesMatchPlayEventViewBean.format_player_points(player['sessionPoints']) }} </td>
                    <td>{{ singlesMatchPlayEventViewBean.format_player_points(player['seasonPoints']) }} </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="3"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
        </table>
    </div>
    
{% endblock %}