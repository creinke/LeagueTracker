{# templates/event/view.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0.1em;
            height: 1.5em;
            width: 50%;
        }
    </style>
    
    <h2>Event# {{ event.eventnumber }}</h2>
    
	<div class="table-responsive" style="width: 100%;">
        <table class="table">
        	<thead>
            	<tr>
                	<th>Start Date and Time</th>
                    <th>Event Type</th>
                    <th>Event Format</th>
                    <th>First Nine</th>
                    <th>Second Nine</th>
                    <th 
                        {% if event.mixedteesenabled %}
                            style="display: none;"
                        {% endif %}>
                        Tee
                    </th>
            	</tr>
            </thead>
            <tbody>
                <tr>
                    <td style="width: 10%;">{{ event.startdateandtime|date("n/j/y @ g:ia") }}</td>
                    <td style="width: 10%;">{{ event.eventtypeString }}</td>
                    <td style="width: 10%;">{{ event.formatString }}</td>
                    <td style="width: 10%;">{{ event.nine.name }}</td>
                    <td style="width: 10%;">{{ event.secondnine is empty ? 'Not played' : event.secondnine.name }}</td>
                    <td 
                        {% if event.mixedteesenabled %}
                            style="display: none;"
                        {% else %}
                            style="width: 10%;"
                        {% endif %}>
                        {{ event.tee.name }}
                    </td>
                </tr>
            </tbody>
        </table>
    
        <h3 style="color: white;">Games</h3>
        
        {% if event.isTeamEvent(event.eventtype) %}
            {% if event.teamgames is not empty  %}
                {% set teamgames = event.teamgames %}
                <table class="table">
                    <tbody>
                        {% for teamgame in teamgames %}
                            <tr>
                                <td style="width: 25%;">Game #{{ loop.index }} @ {{ teamgame.startingtime|date("g:ia")  }}</td>
                                <td style="width: 45%;">
                                    {{ teamgame.teamone }} 
                                    
                                    {% if teamgame.teamtwo is not empty %}
                                        - playing with - {{ teamgame.teamtwo }}
                                    {% endif %}
                                </td>
                                <td style="width: 30%;" nowrap><a href="{{ path('teamgame_post_scores', {'event_id': event.id, 'teamgame_id': teamgame.id, 'gamenumber': loop.index, }) }}" class="btn btn-primary btn-sm">Post/Edit Scores</a>
                                <td>&nbsp;</td>
                                <td></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% elseif event.games is not empty %}
            {% set games = event.sortedGames %}
            <table class="table">
                <tbody>
                    {% for game in games %}
                        <tr>
                            <td style="width: 25%;">Game #{{ loop.index }} @ {{ game.startingtime|date("g:ia")  }}</td>
                            
                            {% if singlesMatch %}
                                {% if matchPlay %}
                                    <td  style="width: 45%;">
                                        {% for playermatch in game.playermatches %}
                                            {% if loop.index0 != 0 %}
                                                , 
                                            {% endif %}
                                            {{ playermatch.playerone.name.lastname }} vs
                                            {{ playermatch.playertwo.name.lastname }}
                                        {% endfor %}
                                    </td>
                                {% else %}
                                    <td  style="width: 45%;">
                                        {% for player in game.players %}
                                            {% if loop.index0 != 0 %}
                                                , 
                                            {% endif %}
                                            {{ player.name.lastname }}
                                        {% endfor %}
                                    </td>
                                {% endif %}
                            {% else %}
                                {% set teammatch = game.teammatches[0] %}
                                {% set teamone = teammatch.teamone %}
                                {% set teamtwo = teammatch.teamtwo %}
            
                                <td style="width: 45%;">{{ teamone.name }} vs {{ teamtwo.name }}</td>
                            {% endif %}
                            
                            <td style="width: 30%;" nowrap><a href="{{ path('post_scores', {'event_id': event.id, 'game_id': game.id, 'gamenumber': loop.index, }) }}" class="btn btn-primary btn-sm">Post/Edit Scores</a>
        					<td>&nbsp;</td>
    						<td></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
    <a href="{{ path('event_list', {'id': season.id}) }}" class="btn btn-dark">Back</a>
{% endblock %}