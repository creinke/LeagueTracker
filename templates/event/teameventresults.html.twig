{# templates/event/teameventresults.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .hr-reverted {
        	width: 100% !important;
        	height: unset !important; 
        	border-bottom: 1px solid #555 !important;
        	background-image: unset !important; 
        	background-size: unset !important; 
        	background-position: center !important; 
        	background-repeat: unset !important; 
        	margin: unset !important; 
        	position: unset !important; 
        	border: unset !important; 
        	content: unset !important;
        	z-index: unset !important; 
        }
		.table, .table-responsive {
			background-image: unset;
			margin-bottom: 30px;
		}
        th {
            text-align: center;
            white-space: nowrap;
        }
        .table td, .table > tbody > tr > td, .table th, .table > tbody > tr > th, .table tr td:first-child {
            border-top: 1px;
            box-shadow: unset; 
            padding: 0px !important;
            color: #555;
            text-align: center;
        }
    </style>
    
    {% set sessionName = event.session.name %}

    <h3>
        {{ league.name }}: {{ season.name }} Season 
            <input type="button" value="Print Results" id="print_button" class="btn btn-primary mt-3" style="float:right;"/>
    </h3>
    
    <h4>Results for {{ sessionName }} Event# {{ event.eventnumber }}</h4>
    <h4 style="margin-left: 5em;">{{ teamEventViewBean.description }}</h4>
    <br/><br/>
    
    <div class="table-responsive"> 
        <table class="table table-condensed">
            <tr>
                <th>Team Name</th>
                <th>Place</th>
                {% if teamEventViewBean.displayNet %}
                    <th>Net Score</th>
                {% endif %}
                {% if teamEventViewBean.displayTotal %}
                    <th>Total Score</th>
                {% endif %}
                <th>Tie Breaker</th>
            </tr>
            <tr>
                <td colspan="5"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
            {# $standings #}
            {% for team in teamEventViewBean.teams %}
                <tr>
                    <td style="text-align: left;">{{ team['name'] }}</td>
                    <td>{{ team['place'] }}</td>
                    {% if teamEventViewBean.displayNet %}
                        <td>{{ teamEventViewBean.isLowTeamNet ? team['totalTeamNetScore'] : team['totalNetScore'] }}</td>
                    {% endif %}
                    {% if teamEventViewBean.displayTotal %}
                        <td>{{ teamEventViewBean.isLowTeamNet ? team['totalTeamScore'] : team['totalScore'] }}</td>
                    {% endif %}
                    <td>
                        {% if team['tieBreaker'] is not empty %}
                            {{ team['tieBreaker'] }}
                        {% else %}
                            &nbsp;
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="5"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
        </table>
    </div>
    
    <div class="table-responsive"> 
        {% set ninesPlayed = teamEventViewBean.ninesPlayed %}
        {% set firstNine = event.nine.name %}
        {% set secondNine = ninesPlayed == 1 ? null : event.secondnine.name %}
        
        <!-- Player Results Table -->
        <table class="table table-condensed">
            <tr>
                <th colspan="3">&nbsp;</th>
                <th colspan="9">
                    Actual Scores
                    {% if teamEventViewBean.displayNet %}
                        /Net Scores
                    {% endif %}
                </th>
                <th colspan="3">&nbsp;</th>
            </tr>
    
            <tr>
                <th style="text-align: left;">Team</th>
                <th style="text-align: left;">Player</th>
                {% if  ninesPlayed > 1 %}
                    <th>Nine</th>
                {% endif %}
                <th>HC</th>
                <th>1</th>
                <th>2</th>
                <th>3</th>
                <th>4</th>
                <th>5</th>
                <th>6</th>
                <th>7</th>
                <th>8</th>
                <th>9</th>
                {% if teamEventViewBean.displayTotal %}
                    <th>Total</th>
                {% endif %}
                {% if teamEventViewBean.displayNet %}
                    <th>Net</th>
                {% endif %}
            </tr>
            <tr>
                <td colspan="15"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>

            {# $playerResults #}
            {% for team in teamEventViewBean.teams %}
                <tr>
                    <td style="text-align: left;">{{ team['name'] }} </td>
                    <td colspan="15">&nbsp;</td>
                </tr>
                {% for player in team['players'] %}
                    <tr>
                        <td>&nbsp;</td>
                        <td style="text-align: left;">{{ player['name'] }}</td>
                            
                        {% if  ninesPlayed > 1 %}
                            <td>{{ firstNine }}</td>
                        {% endif %}
                        <td>
                            {{ player['handicap'] }}
                            
                            {% if  ninesPlayed > 1 %}
                                /{{ player['handicap'] * 2 }}
                            {% endif %}
                        </td>
    
                        {% for holeNumber in 0..8 %}
                            <td>
                                {{ player['firstNineScores'][holeNumber] }}
                                
                                {% if teamEventViewBean.displayNet %}
                                    {% if player['firstNineScores'][holeNumber] > player['firstNineNetScores'][holeNumber] %}
                                        /{{ player['firstNineNetScores'][holeNumber] }}
                                    {% endif %}
                                {% endif %}
                            </td>
                        {% endfor %}
                        {% if teamEventViewBean.displayTotal %}
                            <td>{{ player['firstNineTotalScore'] }}</td>
                        {% endif %}
                        {% if teamEventViewBean.displayNet %}
                            <td>{{ player['firstNineTotalNetScore'] }}</td>
                        {% endif %}
                    </tr>
                    
                    <tr>
                        <td colspan="15"><hr style="border-bottom: 1px solid #555 !important;" class="hr-reverted"/></td>
                    </tr>
                {% endfor %}
                <tr>
                    <td style="text-align: left;">
                        {% if teamEventViewBean.isLowTeamNet %}
                            Team Net
                        {% else %}
                            Better Ball
                        {% endif %}
                    </td>
                    <td>&nbsp;</td>
                        
                    {% if  ninesPlayed > 1 %}
                        <td>{{ firstNine }}</td>
                    {% endif %}
                    <td>
                        &nbsp;
                    </td>

                    {% for holeNumber in 0..8 %}
                        {% if teamEventViewBean.isLowTeamNet %}
                            <td>&nbsp;</td>
                        {% else %}
                            <td>
                                {% if teamEventViewBean.withHandicapping %}
                                    {{ team['firstNineNetScores'][holeNumber] }}
                                {% else %}
                                    {{ team['firstNineScores'][holeNumber] }}
                                {% endif %}
                            </td>
                        {% endif %}
                    {% endfor %}
                    {% if teamEventViewBean.displayTotal %}
                        <td>{{ teamEventViewBean.isLowTeamNet ? team['firstNineTotalTeamScore'] : team['firstNineTotalScore'] }}</td>
                    {% endif %}
                    {% if teamEventViewBean.displayNet %}
                        <td>{{ teamEventViewBean.isLowTeamNet ? team['firstNineTotalTeamNetScore'] : team['firstNineTotalNetScore'] }}</td>
                    {% endif %}
                </tr>
                
                <tr>
                    <td colspan="15"><hr style="border-bottom: 1px solid #555 !important;" class="hr-reverted"/></td>
                </tr>

                {% if ninesPlayed > 1 %}
                    {% for player in team['players'] %}
                        <tr>
                            <td>&nbsp;</td>
                            <td style="text-align: left;">{{ player['name'] }}</td>
                                
                            <td>{{ secondNine }}</td>
                            <td>{{ player['handicap'] }}/{{ player['handicap'] * 2 }}</td>
        
                            {% for holeNumber in 0..8 %}
                                <td>
                                    {{ player['secondNineScores'][holeNumber] }}
                                    
                                    {% if teamEventViewBean.displayNet %}
                                        {% if player['secondNineScores'][holeNumber] > player['secondNineNetScores'][holeNumber] %}
                                            /{{ player['secondNineNetScores'][holeNumber] }}
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endfor %}
                            
                            {% if teamEventViewBean.displayTotal %}
                                <td>{{ player['secondNineTotalScore'] }}</td>
                            {% endif %}
                            {% if teamEventViewBean.displayNet %}
                                <td>{{ player['secondNineTotalNetScore'] }}</td>
                            {% endif %}
                        </tr>
                        
                        <tr>
                            <td colspan="15"><hr style="border-bottom: 1px solid #555 !important;" class="hr-reverted"/></td>
                        </tr>
                    {% endfor %}
                    <tr>
                        <td style="text-align: left;">
                            {% if teamEventViewBean.isLowTeamNet %}
                                Team Net
                            {% else %}
                                Better Ball
                            {% endif %}
                        </td>
                        <td>&nbsp;</td>
                            
                        <td>{{ secondNine }}</td>
                        <td>
                            &nbsp;
                        </td>
    
                        {% for holeNumber in 0..8 %}
                            {% if teamEventViewBean.isLowTeamNet %}
                                <td>&nbsp;</td>
                            {% else %}
                                <td>
                                    {{ team['secondNineScores'][holeNumber] }}
                                    
                                    {% if teamEventViewBean.displayNet %}
                                        {% if team['secondNineScores'][holeNumber] > team['secondNineNetScores'][holeNumber] %}
                                            /{{ team['secondNineNetScores'][holeNumber] }}
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endif %}
                        {% endfor %}
                        
                        {% if teamEventViewBean.displayTotal %}
                            <td>{{ teamEventViewBean.isLowTeamNet ? team['secondNineTotalTeamScore'] : team['secondNineTotalScore'] }}</td>
                        {% endif %}
                        {% if teamEventViewBean.displayNet %}
                            <td>{{ teamEventViewBean.isLowTeamNet ? team['secondNineTotalTeamNetScore'] : team['secondNineTotalNetScore'] }}/{{ teamEventViewBean.isLowTeamNet ? team['totalTeamNetScore'] : team['totalNetScore'] }}</td>
                        {% endif %}
                    </tr>
                {% endif %}

                <tr>
                    <td colspan="15"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
                </tr>
            {% endfor %}
        </table>
    </div>
    
{% endblock %}