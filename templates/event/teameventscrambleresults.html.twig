{# templates/event/teameventscrambleresults.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .hr-reverted {
        	width: 100% !important;
        	height: unset !important; 
        	border-bottom: 1px solid #555 !important;
        	background-image: unset !important; 
        	background-size: unset !important; 
        	background-position: center !important; 
        	background-repeat: unset !important; 
        	margin: unset !important; 
        	position: unset !important; 
        	border: unset !important; 
        	content: unset !important;
        	z-index: unset !important; 
        }
		.table, .table-responsive {
			background-image: unset;
			margin-bottom: 30px;
		}
        th {
            text-align: center;
            white-space: nowrap;
        }
        .table td, .table > tbody > tr > td, .table th, .table > tbody > tr > th, .table tr td:first-child {
            border-top: 1px;
            box-shadow: unset; 
            padding: 0px !important;
            color: #555;
            text-align: center;
        }
    </style>
    
    {% set sessionName = event.session.name %}

    <h3>
        {{ league.name }}: {{ season.name }} Season 
            <input type="button" value="Print Results" id="print_button" class="btn btn-primary mt-3" style="float:right;"/>
    </h3>
    
    <h4>Results for {{ sessionName }} Event# {{ event.eventnumber }}</h4>
    <h4 style="margin-left: 5%;">{{ teamEventViewBean.description }}</h4>
    
    {% if teamEventViewBean.isScramble and teamEventViewBean.withHandicapping %}
        <h5 style="margin-left: 5%;">Team handicap is sum of: <br/> 
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;35 and 15% of A and B player's handicap respectively for 2 person teams <br/>  
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;20, 15, and 10% of A, B, and C player's handicap respectively for 3 person teams and <br/> 
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;20, 15, 10, and 5% of A, B, C, and D player's handicap respectively for 4 person teams
        </h5>
    {% endif %}
    
    <br/><br/>
    
    <div class="table-responsive"> 
        <table class="table table-condensed">
            <tr>
                <th>Team Name</th>
                <th>Place</th>
                <th>Total Score</th>
                {% if teamEventViewBean.withHandicapping %} 
                    <th>Net Score</th>
                {% endif %}
                <th>Tie Breaker</th>
            </tr>
            <tr>
                <td colspan="5"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
            {# $standings #}
            {% for team in teamEventViewBean.teams %}
                <tr>
                    <td style="text-align: left;">{{ team['name'] }}</td>
                    <td>{{ team['place'] }}</td>
                    <td>{{ team['totalScore'] }}</td>
                    {% if teamEventViewBean.withHandicapping %} 
                        <td>{{ team['totalNetScore'] }}</td>
                    {% endif %}
                    <td>
                        {% if team['tieBreaker'] is not empty %}
                            {{ team['tieBreaker'] }}
                        {% else %}
                            &nbsp;
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="5"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
            </tr>
        </table>
    </div>
    
    <div class="table-responsive"> 
        {% set ninesPlayed = teamEventViewBean.ninesPlayed %}
        {% set firstNine = event.nine.name %}
        {% set secondNine = ninesPlayed == 1 ? null : event.secondnine.name %}
        
        <!-- Player Results Table -->
        <table class="table table-condensed">
            <tr>
                <th colspan="3">&nbsp;</th>
                <th colspan="9">Team Score</th>
                <th colspan="3">&nbsp;</th>
            </tr>
    
            <tr>
                <th style="text-align: left;">Team</th>
                {% if teamEventViewBean.withHandicapping %} 
                    <th>Handicap</th>
                {% endif %}
                
                {% if  ninesPlayed > 1 %}
                    <th>Nine</th>
                {% endif %}
                <th style="width: 3em;">1</th>
                <th style="width: 3em;">2</th>
                <th style="width: 3em;">3</th>
                <th style="width: 3em;">4</th>
                <th style="width: 3em;">5</th>
                <th style="width: 3em;">6</th>
                <th style="width: 3em;">7</th>
                <th style="width: 3em;">8</th>
                <th style="width: 3em;">9</th>
                <th>Total</th>
                {% if teamEventViewBean.withHandicapping %} 
                    <th>Net</td>
                {% endif %}
            </tr>
            <tr>
                <td colspan="15"><hr style="border-bottom: 3px solid #555 !important;" class="hr-reverted"/></td>
            </tr>

            {% for team in teamEventViewBean.teams %}
                <tr>
                    <td style="text-align: left;">{{ team['name'] }} </td>
                    
                    {% if teamEventViewBean.withHandicapping %} 
                        <td>{{ team['handicap'] }}</td>
                    {% endif %}
                    
                    {% if  ninesPlayed > 1 %}
                        <td>{{ firstNine }}</td>
                    {% endif %}
                    
                    {% for holeNumber in 0..8 %}
                        <td style="width: 3em;">
                            {% if teamEventViewBean.withHandicapping %} 
                                {% if team['firstNineNetScores'][holeNumber] < team['firstNineScores'][holeNumber] %}
                                    {{ team['firstNineScores'][holeNumber] }}/{{ team['firstNineNetScores'][holeNumber] }}
                                {% else %}
                                    {{ team['firstNineScores'][holeNumber] }}
                                {% endif %}
                            {% else %}
                                {{ team['firstNineScores'][holeNumber] }}
                            {% endif %}
                            &nbsp;
                        </td>
                    {% endfor %}
                    
                    <td>{{ team['firstNineTotalScore'] }}</td>
                    
                    {% if teamEventViewBean.withHandicapping %} 
                        <td>
                            {{ team['firstNineTotalNetScore'] }}
                        </td>
                    {% endif %}
                </tr>
                
                <tr>
                    <td colspan="15"><hr style="border-bottom: 1px solid #555 !important;" class="hr-reverted"/></td>
                </tr>

                {% if ninesPlayed > 1 %}
                    <tr>
                        <td>&nbsp;</td>

                        {% if teamEventViewBean.withHandicapping %} 
                            <td>&nbsp;</td>
                        {% endif %}
                
                        <td>{{ secondNine }}</td>

                        {% for holeNumber in 0..8 %}
                            <td>
                                {% if teamEventViewBean.withHandicapping %} 
                                    {% if team['secondNineNetScores'][holeNumber] < team['secondNineScores'][holeNumber] %}
                                        {{ team['secondNineScores'][holeNumber] }}/{{ team['secondNineNetScores'][holeNumber] }}
                                    {% else %}
                                        {{ team['secondNineScores'][holeNumber] }}
                                    {% endif %}
                                {% else %}
                                    {{ team['secondNineScores'][holeNumber] }}
                                {% endif %}
                                &nbsp;
                            </td>
                        {% endfor %}
                        
                        <td>{{ team['secondNineTotalScore'] }}/{{ team['totalScore'] }}</td>
                        
                        {% if teamEventViewBean.withHandicapping %} 
                            <td>
                                {{ team['secondNineTotalNetScore'] }}/{{ team['totalNetScore'] }}
                            </td>
                        {% endif %}
                    </tr>
                {% endif %}

                <tr>
                    <td colspan="15"><hr style="border-bottom: 2px solid #555 !important;" class="hr-reverted"/></td>
                </tr>
            {% endfor %}
        </table>
    </div>
    
{% endblock %}