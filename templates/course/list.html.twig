{# templates/player/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    <h2>Courses Defined in League Tracker Database</h2>
    
    <div class="text-right"> <!--You can add col-lg-12 if you want -->
        {% if is_granted('ROLE_SUPER') %}
        <a href="{{ path('course_new') }}" class="btn btn-dark">Add New Course</a>
        {% endif %}
    </div>
    
    {% if courses %}
        <div class="table-responsive"> 
            <table class="table table-striped table-condensed">
                <thead>
                    <tr>
                        <th>Course Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for course in courses %}
                        <tr>
                            <td>{{ course.name }}</td>
                            <td>
                                {% if is_granted('ROLE_SUPER') %}
                                    <a href="{{ path('course_delete', {'id': course.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                <a href="{{ path('course_edit', {'id': course.id}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>No courses yet defined in League Tracker database</p>
    {% endif %}
{% endblock %}