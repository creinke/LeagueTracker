{# templates/player/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    <h2>Members of {{ league }}</h2>
    
    <div class="text-right"> <!--You can add col-lg-12 if you want -->
        <a href="{{ path('player_new') }}" class="btn btn-dark">Add New Player</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('player_newlist') }}" class="btn btn-dark">Add Player List</a>
        {% endif %}
    </div>
    
    {% if playersData %}
        <div class="table-responsive"> 
            <table class="table table-striped table-condensed">
                <thead>
                    <tr>
                        <th>Player Name</th>
                        <th>Type</th>
                        <th>Handicap<br/>Index</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for playerData in playersData %}
                        {% set player = playerData['player'] %}
                        {% set playerInfo = playerData['info'] %}
                        
                        <tr>
                            <td>{{ player.name.fullname }}</td>
                            <td>{{ player.type }}</td>
                            <td>{{ playerInfo['currentHandicapIndex'] }}</td>
                            <td>
                                <a href="{{ path('player_view', {'id': player.id}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                {% if is_granted('ROLE_SAMPLE') %}
                                {% elseif is_granted('ROLE_ADMIN') %}
                                    {% if player.defunct %}
                                        <a href="{{ path('player_undefunct', {'id': player.id}) }}" class="btn btn-danger btn-sm" data-method="POST">Undefunct</a>
                                    {% else %}
                                        <a href="{{ path('player_delete', {'id': player.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                    {% endif %}
                                {% endif %}
                                <a href="{{ path('player_edit', {'id': player.id}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                <a href="{{ path('player_handicap', {'id': player.id}) }}" class="btn btn-secondary btn-sm" data-method="GET">Handicap</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>No players yet defined in League</p>
    {% endif %}
{% endblock %}