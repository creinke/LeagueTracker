{# templates/player/newlist.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    <div>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            
            <div class="table-responsive"> 
                <table class="table table-striped table-condensed">
                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Middle Name or Initial</th>
                            <th>Last Name</th>
                            <th>Generation</th>
                            <th>Seed</th>
                            <th>Player Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for player in form.players %}
                            <tr>
                                <td>{{ form_widget(player.firstname) }}</td>
                                <td>{{ form_widget(player.middlenameorinitial) }}</td>
                                <td>{{ form_widget(player.lastname) }}</td>
                                <td>{{ form_widget(player.generation, {'attr' : {'style' : 'height:35px'}}) }}</td>
                                <td>{{ form_widget(player.seedhandicapindex, {'attr' : {'style' : 'width:5em'}})  }}</td>
                                <td>{{ form_widget(player.type, {'attr' : {'style' : 'height:35px'}}) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}