{# templates/game/view.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0.1em;
            height: 1.5em;
            width: 50%;
        }
    </style>
    
    {% if singlesMatch %}
        {% if matchPlay %}
            <h2>Singles Match Play</h2>
        {% else %}
            <h2>Singles Stroke Play</h2>
        {% endif %}           
    {% else %}        
        <h2>Team Match Play</h2>
    {% endif %} 
              
    <h3>Game #{{ gamenumber }} on {{ event.startdateandtime|date("m/d/Y") }} @ {{ game.startingtime|date("g:ia")  }}</h3>
    
    <table class="table table-striped">
        <tbody>
            {% if singlesMatch %}
                {% if matchPlay %}
                    {% set players = game.matchPlayers %}
                    {% set playerCount = players|length %}
                
                    <tr>
                        <td style="width: 45%;">{{ players[0].name.fullname }}</td>
                        <td style="width: 5%;">vs</td>
                        <td style="width: 50%;">{{ players[1].name.fullname }}</td>
                    </tr>
                    {% if playerCount > 2 %}
                        <tr>
                            <td style="width: 45%;">{{ players[2].name.fullname }}</td>
                            <td style="width: 5%;">vs</td>
                            <td style="width: 50%;">{{ players[3].name.fullname }}</td>
                        </tr>
                    {% endif %}
                {% else %}
                    {% for player in game.players %}
                        <tr>
                            <td style="width: 10%;">Player[{{ loop.index }}]</td>
                            <td>{{ player.name.fullname }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}           
            {% else %}        
                {% set teammatch = game.teammatches[0] %}
                {% set teamone = teammatch.teamone %}
                {% set teamtwo = teammatch.teamtwo %}
                
                <tr>
                    <td>Team Match:</td>
                    <td>{{ teamone.name }} vs {{ teamtwo.name }}</td>
                </tr>
                <tr>
                    <td>Player Match One:</td>
                    <td>{{ teamone.players[0].name.fullname }} vs {{ teamtwo.players[0].name.fullname }}</td>
                </tr>
                <tr>
                    <td>Player Match Two:</td>
                    <td>{{ teamone.players[1].name.fullname }} vs {{ teamtwo.players[1].name.fullname }}</td>
                </tr>
            {% endif %}           
        </tbody>
    </table>
{% endblock %}