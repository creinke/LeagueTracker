{# templates/game/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .form-control {
            padding: 0.3em inherit;
            height: 2.5em;
            width: 100%;
        }
        label {
            margin-bottom: 0.15em;
        }
    </style>

    <div>
        <h2>Team Match Play</h2>
        <h3>Game #{{ gamenumber }} on {{ eventStartdateandtime|date("m/d/Y") }} @ {{ gameStartingtime|date("g:ia")  }}</h3>
    
        {{ form_start(form) }}
        {{ form_widget(form) }}
        {{ form_end(form) }}
    </div>
    
{% endblock %}