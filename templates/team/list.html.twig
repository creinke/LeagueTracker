{# templates/team/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    <h2>{{ league }} Teams</h2>
    
    <div class="text-right"> <!--You can add col-lg-12 if you want -->
        <a href="{{ path('team_new') }}" class="btn btn-dark">Add New Team</a>
        <a href="{{ path('team_newlist') }}" class="btn btn-dark">Add Team List</a>
    </div>
    
    {% if teams %}
        <div class="table-responsive"> 
            <table class="table table-striped table-condensed">
                <thead>
                    <tr>
                        <th>Team Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for team in teams %}
                        <tr>
                            <td>{{ team.name }}</td>
                            <td>
                                <a href="{{ path('team_view', {'id': team.id}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                {% if is_granted('ROLE_SAMPLE') %}
                                {% elseif is_granted('ROLE_ADMIN') %}
                                    {% if team.defunct %}
                                        <a href="{{ path('team_undefunct', {'id': team.id}) }}" class="btn btn-danger btn-sm" data-method="POST">Undefunct</a>
                                    {% else %}
                                        <a href="{{ path('team_delete', {'id': team.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                    {% endif %}
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                	<a href="{{ path('team_edit', {'id': team.id}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>No teams yet defined in League</p>
    {% endif %}
{% endblock %}