{# templates/team/newlist.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    <div>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            
            <div class="table-responsive"> 
                <table class="table table-striped table-condensed">
                    <thead>
                        <tr>
                            <th>Team Name</th>
                            <th>Team Number</th>
                            <th>Player One</th>
                            <th>Player Two</th>
                            <th>Player Three</th>
                            <th>Player Four</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for team in form.teams %}
                            <tr>
                                <td>{{ form_widget(team.name, {'attr' : {'style' : 'height:35px'}}) }}</td>
                                <td>{{ form_widget(team.teamnumber, {'attr' : {'style' : 'width:50px'}}) }}</td>
                                <td>{{ form_widget(team.players[0], {'attr' : {'style' : 'height:35px'}}) }}</td>
                                <td>{{ form_widget(team.players[1], {'attr' : {'style' : 'height:35px'}}) }}</td>
                                <td>{{ form_widget(team.players[2], {'attr' : {'style' : 'height:35px'}}) }}</td>
                                <td>{{ form_widget(team.players[3], {'attr' : {'style' : 'height:35px'}}) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}