{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .payments-page {
            max-width: 1100px;
            margin: 0 auto;
        }

        .payments-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        .payments-table th,
        .payments-table td {
            padding: 0.6rem 0.75rem;
            border: 1px solid #ccc;
            text-align: left;
        }

        .payments-table th {
            background: #f5f5f5;
        }

        .payments-table td.amount,
        .payments-table td.date {
            white-space: nowrap;
        }

        .payments-table td.balance {
            font-weight: 700;
            color: #b00020;
        }

        .payment-section {
            margin-bottom: 1.5rem;
        }
    </style>

    <div class="payments-page">
        <h1>{{ title }}</h1>

        <table class="payments-table">
            <thead>
                <tr>
                    <th rowspan="2">Team #</th>
                    <th rowspan="2">Last Name</th>
                    <th rowspan="2">First Name</th>
                    <th rowspan="2">Owes</th>
                    <th colspan="2">Carry-over Winnings</th>
                    <th colspan="2">Payment</th>
                    <th rowspan="2">Balance</th>
                </tr>
                <tr>
                    <th>Paid</th>
                    <th>Date</th>
                    <th>Paid</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                {% for payment in payments %}
                    <tr>
                        <td>{{ payment.team }}</td>
                        <td>{{ payment.lastName }}</td>
                        <td>{{ payment.firstName }}</td>
                        <td class="amount">{{ payment.owes|number_format(2) }}</td>
                        <td class="amount">
                            {% if payment.carryOverPaid is not null %}
                                {{ payment.carryOverPaid|number_format(2) }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="date">{{ payment.carryOverDate ?? '' }}</td>
                        <td class="amount">
                            {% if payment.paymentPaid is not null %}
                                {{ payment.paymentPaid|number_format(2) }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="date">{{ payment.paymentDate ?? '' }}</td>
                        <td class="amount balance">{{ payment.balance|number_format(2) }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9">No payment records found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="payment-section">
            <p><strong>Payment due by May 15th.</strong></p>
            <p>Make checks payable to <strong>Kurt Reinke</strong>, not the golf course.</p>
        </div>

        <div class="payment-section">
            <p><strong>Mail checks to:</strong></p>
            <p>
                Kurt Reinke<br>
                4952 Whispering Oaks Drive<br>
                North Port, FL 34287
            </p>
        </div>

        <div class="payment-section">
            <p><strong>Other payment options:</strong></p>

            <p>
                <strong>Venmo</strong><br>
                Username: Curtis-Reinke-1<br>
                Email: creinke@rkm-associates.com<br>
                Phone: (248) 761-4370
            </p>

            <p>
                <strong>Square Cash</strong><br>
                Cash Tag: $KurtReinke<br>
                Email: creinke@rkm-associates.com<br>
                Phone: (248) 761-4370
            </p>

            <p>
                <strong>PayPal</strong><br>
                Use the <strong>Friends and Family</strong> option, not goods and services, to avoid fees.<br>
                Email: creinke@rkm-associates.com<br>
                Phone: (248) 761-4370
            </p>
        </div>
    </div>
{% endblock %}