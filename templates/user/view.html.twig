{# templates/user/view.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0.1em;
            height: 1.5em;
            width: 50%;
        }
    </style>
    
    <h2>{{ user.username }}</h2>
    
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>User Name:</td>
                <td>{{ user.username }}</td>
            </tr>
            <tr>
                <td>Encoded Password:</td>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <td>League Name:</td>
                <td>{{ user.leagueName }}</td>
            </tr>
            <tr>
                <td>Roles:</td>
                <td>{{ user.roleList }}</td>
            </tr>
        </tbody>
    </table>
    
    <a href="{{ path('user_list') }}" class="btn btn-dark">Back</a>
{% endblock %}