{# templates/user/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .form-control {
            padding:0px 0px 0px .3em; 
        }
        label {
            margin-bottom: 0.15em;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
        </style>

    <div>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.username) }}
            {{ form_row(form.leagueName) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.roleList) }}
	        {{ form_row(form.save) }}
        {{ form_end(form) }}
    </div>
{% endblock %}