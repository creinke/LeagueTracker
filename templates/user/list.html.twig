{# templates/user/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    {% if not users %}
        <div class="text-right"> <!--You can add col-lg-12 if you want -->
            <a href="{{ path('user_new') }}" class="btn btn-dark">Add New User</a>
       </div>
       
       <p>No users yet defined</p>
    {% else %}
        <h2>Users</h2>
    
        <div class="text-right"> <!--You can add col-lg-12 if you want -->
            <a href="{{ path('user_new') }}" class="btn btn-dark">Add New User</a>
       </div>

        <div class="table-responsive"> 
            <table class="table table-striped table-condensed">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.username }}</td>
                            <td>
                                <a href="{{ path('user_view', {'id': user.id}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                <a href="{{ path('user_delete', {'id': user.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}