{# templates/session/view.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0.1em;
            height: 1.5em;
            width: 50%;
        }
    </style>
    
    <h2>{{ session.name }}</h2>
    
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>Start Date:</td>
                <td>{{ session.startdate|date("n/j/y") }}</td>
            </tr>
            <tr>
                <td>End Date:</td>
                <td>{{ session.enddate|date("n/j/y")  }}</td>
            </tr>
        </tbody>
    </table>
    
    <a href="{{ path('session_list', {'id': season.id}) }}" class="btn btn-dark">Back</a>
{% endblock %}