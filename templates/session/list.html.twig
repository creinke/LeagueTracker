{# templates/session/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <style>
        .btn {
            padding: 0.15rem 0.275rem;
        }
        .table td {
            padding: 0px;
            height: 1.5em;
        }
        .table th {
            padding: 0px;
            height: 1.5em;
        }
    </style>

    {% if sessions.count() == 0 %}
        <div class="text-right"> <!--You can add col-lg-12 if you want -->
            <a href="{{ path('session_new', {'id': season.id}) }}" class="btn btn-dark">Add New Session</a>
       </div>
       
       <p>No sessions yet defined in {{ season.name }} Season</p>
    {% else %}
        <h2>Sessions for {{ season.name }} Season</h2>
    
        <div class="text-right"> <!--You can add col-lg-12 if you want -->
            <a href="{{ path('session_new', {'id': season.id}) }}" class="btn btn-dark">Add New Session</a>
       </div>

        <div class="table-responsive"> 
            <table class="table table-striped table-condensed">
                <thead>
                    <tr>
                        <th>Session</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for session in sessions %}
                        <tr>
                            <td>{{ session.name }}</td>
                            <td>
                                <a href="{{ path('session_view', {'id': session.id}) }}" class="btn btn-info btn-sm" data-method="GET">View</a>
                                {% if is_granted('ROLE_SAMPLE') %}
                                {% elseif is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('session_delete', {'id': session.id}) }}" class="btn btn-danger btn-sm" data-method="DELETE">Delete</a>
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('session_edit', {'id': session.id}) }}" class="btn btn-primary btn-sm" data-method="POST">Edit</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}